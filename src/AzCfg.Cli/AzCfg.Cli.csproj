<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <!-- Web SDK only to pack the UI's static web assets (ADR 0016); the Debug-only Hot Reload browser module of the
         Cli itself would collide with the one of AzCfg.Ui. -->
    <EnableHotReloadInRuntimeConfigDevFile>false</EnableHotReloadInRuntimeConfigDevFile>
    <ToolCommandName>azcfg</ToolCommandName>
    <PackageId>AzCfg</PackageId>
    <Version>0.7.0</Version>
    <Description>Local manager for Azure App Configuration and Key Vault: sync configs with local files and edit them as JSON.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.7.0: azcfg.json project manifest (config set project.shared true, bound without the wizard), status --check ManifestInvalid and SecretLikeKeyInTrackedFile, UI Share with team. See https://github.com/lordoleksiy/AzCfg/blob/master/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzCfg.Core\AzCfg.Core.csproj" />
    <ProjectReference Include="..\AzCfg.Infrastructure\AzCfg.Infrastructure.csproj" />
    <ProjectReference Include="..\AzCfg.Ui\AzCfg.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

</Project>
