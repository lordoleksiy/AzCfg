<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>azcfg</ToolCommandName>
    <PackageId>AzCfg</PackageId>
    <Version>0.5.0-preview.1</Version>
    <Description>Local manager for Azure App Configuration and Key Vault: sync configs with local files and edit them as JSON.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/lordoleksiy/AzCfg/blob/master/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzCfg.Core\AzCfg.Core.csproj" />
    <ProjectReference Include="..\AzCfg.Infrastructure\AzCfg.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

</Project>
