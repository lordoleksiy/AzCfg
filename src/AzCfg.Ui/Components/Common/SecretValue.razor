@using AzCfg.Core.Model
@using AzCfg.Ui.Application.Security
@using AzCfg.Ui.Application.State
@implements IDisposable
@inject TimeProvider Time
@inject IServiceProvider Services

<span class="az-secret">
    <FluentIcon Value="@(new Icons.Regular.Size16.Key())" Title="Secret" />
    @if (_revealed is null)
    {
        <span class="az-secret-text az-mono">@SecretPolicy.Mask</span>
    }
    else
    {
        <span class="az-secret-text az-mono" data-revealed="true">@_revealed.Reveal()</span>
    }
    @if (OnReveal is not null)
    {
        <button type="button" class="az-secret-toggle" aria-label="@(_revealed is null ? "Reveal" : "Hide")" title="@(_revealed is null ? "Reveal" : "Hide")"
                disabled="@_loading" @onclick="ToggleAsync">
            @if (_revealed is null)
            {
                <FluentIcon Value="@(new Icons.Regular.Size16.Eye())" />
            }
            else
            {
                <FluentIcon Value="@(new Icons.Regular.Size16.EyeOff())" />
            }
        </button>
    }
</span>

@code {
    public static readonly TimeSpan AutoHide = TimeSpan.FromSeconds(30);

    private SecretString? _revealed;
    private ITimer? _timer;
    private CancellationTokenSource? _cts;
    private TabsState? _tabs;
    private Guid? _tabAtReveal;
    private bool _loading;

    /// <summary>Loads the value on demand (Reveal); null result keeps the mask. Without it the component only shows the mask.</summary>
    [Parameter] public Func<CancellationToken, Task<SecretString?>>? OnReveal { get; set; }

    protected override void OnInitialized()
    {
        _tabs = Services.GetService(typeof(TabsState)) as TabsState;
        if (_tabs is not null)
        {
            _tabs.Changed += OnTabsChanged;
        }
    }

    /// <summary>Hides the value and drops it.</summary>
    public void Hide()
    {
        _revealed = null;
        _tabAtReveal = null;
        _timer?.Dispose();
        _timer = null;
        _cts?.Cancel();
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        if (_revealed is not null)
        {
            Hide();
            return;
        }

        if (OnReveal is null)
        {
            return;
        }

        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _loading = true;
        try
        {
            _revealed = await OnReveal(_cts.Token);
        }
        catch (OperationCanceledException)
        {
            _revealed = null;
        }
        finally
        {
            _loading = false;
        }

        if (_revealed is not null)
        {
            _tabAtReveal = _tabs?.ActiveId;
            _timer?.Dispose();
            _timer = Time.CreateTimer(_ => InvokeAsync(Hide), null, AutoHide, Timeout.InfiniteTimeSpan);
        }
    }

    private void OnTabsChanged()
    {
        if (_revealed is not null && _tabs?.ActiveId != _tabAtReveal)
        {
            InvokeAsync(Hide);
        }
    }

    public void Dispose()
    {
        if (_tabs is not null)
        {
            _tabs.Changed -= OnTabsChanged;
        }

        _timer?.Dispose();
        _cts?.Cancel();
        _cts?.Dispose();
        _revealed = null;
    }
}
